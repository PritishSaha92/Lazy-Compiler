.version 8.0
.target sm_89
.address_size 64


.visible .entry k_add_pointwise(
    .param .u64 param_0,
    .param .u64 param_1,
    .param .u64 param_2
)
{
    .reg .b64 %rd<17>;
    .reg .b32 %r<15>;
    .reg .pred %p<2>;
    .reg .f32 %f<7>;
    ld.param.u64 %rd1, [param_0];
    cvta.to.global.u64 %rd2, %rd1;
    ld.param.u64 %rd3, [param_1];
    cvta.to.global.u64 %rd4, %rd3;
    ld.param.u64 %rd5, [param_2];
    cvta.to.global.u64 %rd6, %rd5;
    mov.u32 %r1, %tid.x;
    mov.u32 %r2, %ctaid.x;
    mov.u32 %r3, %ntid.x;
    rem.s32 %r4, %r1, 32;
    div.s32 %r5, %r1, 32;
    mul.lo.s32 %r6, %r2, %r3;
    add.s32 %r7, %r6, %r1;
    setp.ge.s32 %p1, %r7, 64;
    @%p1 bra endtile_1;
    mul.lo.s32 %r8, %r7, 2;
    mul.wide.s32 %rd7, %r8, 4;
    add.u64 %rd8, %rd2, %rd7;
    ld.global.f32 %f1, [%rd8+0];
    mul.lo.s32 %r9, %r7, 2;
    mul.wide.s32 %rd9, %r9, 4;
    add.u64 %rd10, %rd4, %rd9;
    ld.global.f32 %f2, [%rd10+0];
    add.rn.f32 %f3, %f1, %f2;
    mul.lo.s32 %r10, %r7, 2;
    add.s32 %r11, %r10, 1;
    mul.wide.s32 %rd11, %r11, 4;
    add.u64 %rd12, %rd2, %rd11;
    ld.global.f32 %f4, [%rd12+0];
    mul.lo.s32 %r12, %r7, 2;
    add.s32 %r13, %r12, 1;
    mul.wide.s32 %rd13, %r13, 4;
    add.u64 %rd14, %rd4, %rd13;
    ld.global.f32 %f5, [%rd14+0];
    add.rn.f32 %f6, %f4, %f5;
    mul.lo.s32 %r14, %r7, 2;
    mul.wide.s32 %rd15, %r14, 4;
    add.u64 %rd16, %rd6, %rd15;
    st.global.v2.f32 [%rd16], {%f3, %f6};
endtile_1:
    ret;
